# Supabase. Without these the map still runs: pins come from data/seed-pins.json
# and anything you add lives in memory until the server restarts.
# NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Production basemap. Unset in development, which uses public/basemap/us.pmtiles.
# Rebuild the archive with scripts/build-basemap.sh.
# NEXT_PUBLIC_TILE_URL=https://tiles.example.org/us.pmtiles

# Monthly "someone joined near you" digest. Without these nothing is sent and
# the endpoint reports what it would have done.
# DIGEST_SECRET=a-long-random-string
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# DIGEST_FROM=hello@yourdomain.org
# NEXT_PUBLIC_SITE_URL=https://kanazawa-map-ten.vercel.app
