# Supabase. Without these the map still runs: pins come from data/seed-pins.json
# and anything you add lives in memory until the server restarts.
# NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Production basemap. Unset in development, which uses public/basemap/us.pmtiles.
# Rebuild the archive with scripts/build-basemap.sh.
# NEXT_PUBLIC_TILE_URL=https://tiles.example.org/us.pmtiles

# The website this app is served inside, at /counts.
# NEXT_PUBLIC_HOST_URL=https://www.nikkeinexus.org

# Server only. The message relay, moderator emails, bans and the digest.
# SUPABASE_SERVICE_ROLE_KEY=

# Mail. Messages, moderator alerts and the monthly digest all send from
# DIGEST_FROM, which should be a no-reply address.
# RESEND_API_KEY=
# DIGEST_FROM=Nikkei Counts <no-reply@yourdomain.org>

# Vercel Cron sends this as a bearer token to /counts/api/digest.
# CRON_SECRET=a-long-random-string

# Cloudflare Turnstile on the sign-in form. The secret key goes in Supabase.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
